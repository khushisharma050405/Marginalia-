# Database Configuration
DATABASE_URL=postgresql://marginalia:marginalia@localhost:5432/marginalia

# JWT Security Key
JWT_SECRET=replace-with-a-secure-random-secret-key

# Frontend -> Backend API URL (Optional, default is /api_proxy locally)
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://127.0.0.1:8000

# LLM Provider API Keys (Configure at least one)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_LITE=openai/gpt-oss-20b

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite

# Optional: OPENAI_API_KEY / ANTHROPIC_API_KEY / OLLAMA_HOST
# OPENAI_API_KEY=your_openai_key_here
